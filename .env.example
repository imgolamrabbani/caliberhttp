# CaliberHTTP — Polar.sh Public Licensing & Checkout Configuration ($0/mo MoR)
# NOTE: These values are public client-side identifiers. NEVER put a Polar Secret Access Token here.

# Polar Organization UUID (Settings -> General -> Organization ID in polar.sh/dashboard)
POLAR_ORGANIZATION_ID=your-polar-organization-uuid

# Polar Checkout Links (Products -> Checkout Links in polar.sh/dashboard)
POLAR_CHECKOUT_URL_LIFETIME=https://buy.polar.sh/polar_cl_replace_with_lifetime_link
POLAR_CHECKOUT_URL_MONTHLY=https://buy.polar.sh/polar_cl_replace_with_monthly_link

# Polar Customer Portal License Keys API base URL (default: https://api.polar.sh)
POLAR_API_BASE_URL=https://api.polar.sh
